diff --git a/before-source/token-inspector/src/permissions.ts b/after-source/token-inspector/src/permissions.ts
index 080cb76..b3eac25 100644
--- a/before-source/token-inspector/src/permissions.ts
+++ b/after-source/token-inspector/src/permissions.ts
@@ -206,5 +206,12 @@ export function audienceNames(value: unknown): string[] {
   const values = typeof value === 'string' ? [value]
     : Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string')
     : [];
-  return values.map(item => AUDIENCES[item]).filter((name): name is string => Boolean(name));
+  return values.map(item => {
+    const id = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(item) ? item.toLowerCase() : item;
+    if (Object.hasOwn(AUDIENCES, id)) return AUDIENCES[id];
+    // An audience can also be a known application ID (e.g. an ID Token's client).
+    // A name match does not confirm token purpose, trust, or actual authorization.
+    if (Object.hasOwn(CLIENT_APPS, id)) return CLIENT_APPS[id].name;
+    return undefined;
+  }).filter((name): name is string => typeof name === 'string');
 }
diff --git a/before-source/token-inspector/tests/browser/values.spec.ts b/after-source/token-inspector/tests/browser/values.spec.ts
index 0b36117..8e533ca 100644
--- a/before-source/token-inspector/tests/browser/values.spec.ts
+++ b/after-source/token-inspector/tests/browser/values.spec.ts
@@ -50,3 +50,29 @@ test('unknown clients and audiences stay plain while chip titles carry descripti
   await page.locator('#token').fill(token({ roles: [], exp: 4102444800 }));
   await expect(page.locator('#payload-fields')).toContainText('[]');
 });
+
+test('aud shows the concrete recipient beside the original ID and in its explanation', async ({ page }) => {
+  await page.route('**/*', route =>
+    new URL(route.request().url()).hostname === '127.0.0.1' ? route.continue() : route.abort());
+  await page.goto('/');
+  const id = 'c44b4083-3bb0-49c1-b47d-974e53cbdf3c';
+  for (const purpose of ['access', 'id']) {
+    await page.locator(`#tab-${purpose}`).click();
+    await page.locator('#token').fill(token({
+      iss: 'https://sts.windows.net/11111111-1111-1111-1111-111111111111/', aud: id, exp: 4102444800,
+    }));
+    await page.locator('[data-part="payload"][data-view="claims"]').click();
+    const aud = page.locator('#payload-fields tr').filter({ has: page.locator('strong', { hasText: /^aud$/ }) });
+    await expect(aud.locator('code')).toHaveText(JSON.stringify(id));
+    await expect(aud.locator('.value-match')).toHaveText('受众：Azure Portal');
+    await expect(aud.locator('.value-critical')).toHaveCount(0);
+    await expect(aud.locator('td').nth(1)).toContainText('值匹配：受众=Azure Portal（静态名称匹配，未验证）');
+    await expect(page.locator('#payload-json')).toContainText(id);
+    await expect(page.locator('#payload-json')).not.toContainText('Azure Portal');
+  }
+  await page.locator('#token').fill(token({ aud: ['00000003-0000-0000-c000-000000000000', id, 'unknown'] }));
+  await page.locator('[data-part="payload"][data-view="claims"]').click();
+  await expect(page.locator('#payload-fields .value-match')).toHaveText(['受众：Microsoft Graph', '受众：Azure Portal']);
+  await page.locator('#token').fill(token({ aud: 'constructor' }));
+  await expect(page.locator('#payload-fields .value-match')).toHaveCount(0);
+});
diff --git a/before-source/token-inspector/tests/permissions.test.ts b/after-source/token-inspector/tests/permissions.test.ts
index c1b4710..8da84b7 100644
--- a/before-source/token-inspector/tests/permissions.test.ts
+++ b/after-source/token-inspector/tests/permissions.test.ts
@@ -54,4 +54,16 @@ describe('value matching data', () => {
     expect(audienceNames(['https://management.azure.com/', 'unknown'])).toEqual(['Azure 资源管理器']);
     expect(audienceNames({})).toEqual([]);
   });
+
+  it('maps known application audiences without copying client risk labels', () => {
+    expect(audienceNames('c44b4083-3bb0-49c1-b47d-974e53cbdf3c')).toEqual(['Azure Portal']);
+    expect(audienceNames('C44B4083-3BB0-49C1-B47D-974E53CBDF3C')).toEqual(['Azure Portal']);
+    expect(audienceNames(['00000003-0000-0000-c000-000000000000', 'c44b4083-3bb0-49c1-b47d-974e53cbdf3c', 'unknown', null]))
+      .toEqual(['Microsoft Graph', 'Azure Portal']);
+  });
+
+  it('does not resolve unknown or inherited audience keys', () => {
+    expect(audienceNames(['constructor', '__proto__', 'toString', '11111111-1111-1111-1111-111111111111'])).toEqual([]);
+    expect(audienceNames('https://graph.microsoft.com/unknown')).toEqual([]);
+  });
 });
